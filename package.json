{
  "name": "iptv-checker-gui",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "tauri": "bun scripts/run-tauri.ts",
    "typecheck": "tsc --noEmit",
    "test:frontend": "bun test tests",
    "perf:ui-filter": "bun run scripts/benchmark-ui-filter.ts",
    "perf:backend-scan": "cd src-tauri && cargo run --release --example backend_bench --",
    "setup:ffmpeg": "bash scripts/download-ffmpeg.sh",
    "clean:fuzz-local": "bash scripts/clean-fuzz-local.sh",
    "lint": "biome check .",
    "format": "biome check --write .",
    "perf:ui-batching": "bun run scripts/benchmark-result-batching.ts"
  },
  "dependencies": {
    "@bradleyhodges/sfsymbols": "^8.1.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.50.0",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tauri-plugin-liquid-glass-api": "^0.1.6",
    "tauri-plugin-macos-haptics-api": "^1.0.0",
    "tauri-plugin-mcp": "^0.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
